{
  "name": "resume-constructor",
  "version": "1.0.0",
  "description": "A TypeScript application designed to create software-engineering resumes based on principles from the book The Tech Resume Inside Out.",
  "main": "index.tsx",
  "type": "module",
  "scripts": {
    "test": "jest --passWithNoTests",
    "test:ci": "jest --passWithNoTests --watchAll=false",
    "e2e": "docker run --rm -u $(id -u):$(id -g) --network host -v $(pwd):/work/ -w /work/ -it mcr.microsoft.com/playwright:v1.57.0-noble npx playwright test",
    "e2e:update": "docker run --rm -u $(id -u):$(id -g) --network host -v $(pwd):/work/ -w /work/ -it mcr.microsoft.com/playwright:v1.57.0-noble npx playwright test --update-snapshots",
    "start-g": "webpack serve --open-app-name 'google-chrome-stable' --config webpack.dev.cjs",
    "start": "webpack serve --config webpack.dev.cjs",
    "build": "webpack --config webpack.prod.cjs",
    "docs:dev": "bun --cwd docs dev",
    "docs:build": "bun --cwd docs build",
    "docs:check": "bun --cwd docs check",
    "p": "git add . && git commit && git push origin main",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Mikhail Sholokhov",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.13.2",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/babel__core": "^7.20.5",
    "@types/babel__preset-env": "^7.10.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/identity-obj-proxy": "^3.0.2",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.25",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-test-renderer": "^19.3.0",
    "@types/sass-loader": "^8.0.10",
    "@types/webpack": "^5.28.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^10.1.1",
    "babel-plugin-dynamic-import-node": "^2.3.3",
    "babel-plugin-module-resolver": "^5.0.3",
    "canvas": "^3.2.3",
    "clean-webpack-plugin": "^4.0.0",
    "clsx": "^2.1.1",
    "css-loader": "^7.1.5",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jest": "^29.16.6",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "^17.24.0",
    "eslint-plugin-perfectionist": "^4.15.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-you-might-not-need-an-effect": "^0.7.0",
    "eslint-webpack-plugin": "^5.0.3",
    "globals": "^16.5.0",
    "html-loader": "^5.1.0",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.29",
    "postcss-load-config": "^6.0.1",
    "postcss-loader": "^8.2.1",
    "prettier": "^3.9.9",
    "react-test-renderer": "^19.3.0",
    "sass-embedded": "^1.105.1",
    "sass-loader": "^16.0.8",
    "style-loader": "^4.0.0",
    "stylelint": "^17.16.0",
    "stylelint-config-concentric-order": "^5.5.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "stylelint-webpack-plugin": "^5.1.0",
    "tabbable": "^6.5.0",
    "terser-webpack-plugin": "^5.6.1",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "type-fest": "^5.10.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "webpack": "^5.111.1",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.6",
    "webpack-merge": "^6.0.1"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/speed-insights": "^1.3.1",
    "immer": "^10.2.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "use-immer": "^0.11.0"
  },
  "lint-staged": {
    "src/**/*.{mjs,js,jsx,mts,ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown",
      "jest --bail --findRelatedTests --passWithNoTests"
    ],
    "docs/**/*.{ts,tsx,astro}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "docs/**/*.md": "prettier --write --ignore-unknown",
    "*.md": "prettier --write --ignore-unknown",
    "{src,docs}/**/*.{html,json}": "prettier --write --ignore-unknown",
    "src/**/*.scss": [
      "stylelint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@vercel/speed-insights",
    "canvas",
    "unrs-resolver"
  ]
}

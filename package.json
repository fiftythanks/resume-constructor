{
  "name": "resume-constructor",
  "version": "1.0.0",
  "description": "A TypeScript application for automatically generating standard software engineering CVs from user-provided content.",
  "main": "index.tsx",
  "type": "module",
  "scripts": {
    "test": "vitest --typecheck --passWithNoTests",
    "e2e": "docker run --rm -u $(id -u):$(id -g) --network host -v $(pwd):/work/ -w /work/ -it mcr.microsoft.com/playwright:v1.57.0-noble npx playwright test",
    "e2e:update": "docker run --rm -u $(id -u):$(id -g) --network host -v $(pwd):/work/ -w /work/ -it mcr.microsoft.com/playwright:v1.57.0-noble npx playwright test --update-snapshots",
    "start-g": "BROWSER=google-chrome-stable vite --open",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:types": "tsc --noEmit",
    "lint": "eslint .",
    "lint:styles": "stylelint \"src/**/*.scss\"",
    "test:ci": "vitest run --typecheck",
    "verify": "bun run check:types && bun run lint && bun run lint:styles && bun run test:ci && bun run build && bun run docs:check && bun run docs:build",
    "docs:dev": "bun --cwd docs dev",
    "docs:build": "bun --cwd docs build",
    "docs:check": "bun --cwd docs check",
    "prepare": "husky"
  },
  "browserslist": [
    "baseline widely available"
  ],
  "keywords": [],
  "author": "Mikhail Sholokhov",
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@eslint/mcp": "0.3.14",
    "@playwright/mcp": "0.0.83",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/lodash": "^4.17.25",
    "@types/minimatch": "^6.0.0",
    "@types/node": "^25.9.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "8.71.2",
    "@typescript-eslint/parser": "8.71.2",
    "@upstash/context7-mcp": "4.4.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/eslint-plugin": "^1.6.27",
    "canvas": "^3.2.3",
    "clsx": "^2.1.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-n": "18.4.1",
    "eslint-plugin-perfectionist": "4.15.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "0.7.0",
    "globals": "^16.5.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "lodash": "^4.18.1",
    "prettier": "^3.9.9",
    "sass-embedded": "^1.105.1",
    "stylelint": "^17.16.0",
    "stylelint-config-concentric-order": "^5.5.0",
    "stylelint-config-sass-guidelines": "^13.0.0",
    "tabbable": "^6.5.0",
    "type-fest": "^5.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "typescript-language-server": "^6.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.1.1",
    "vitest-browser-react": "^2.3.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/speed-insights": "^1.3.1",
    "immer": "^10.2.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "use-immer": "^0.11.0",
    "zod": "^4.6.7"
  },
  "lint-staged": {
    "src/**/*.{mjs,js,jsx,mts,ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown",
      "vitest related --run --bail=1 --typecheck --passWithNoTests"
    ],
    "docs/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write --ignore-unknown"
    ],
    "docs/**/*.astro": "prettier --write --ignore-unknown",
    "docs/**/*.md": "prettier --write --ignore-unknown",
    "*.md": "prettier --write --ignore-unknown",
    "index.html": "prettier --write --ignore-unknown",
    "{src,docs}/**/*.{html,json}": "prettier --write --ignore-unknown",
    "src/**/*.scss": [
      "stylelint --fix",
      "prettier --write --ignore-unknown"
    ]
  },
  "trustedDependencies": [
    "@parcel/watcher",
    "@vercel/speed-insights",
    "canvas",
    "unrs-resolver"
  ]
}
